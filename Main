local RiftFinder = {}

function RiftFinder.Run(IsVIP)
	local Ver = "0.1.1v."
	local TeleportService = game:GetService("TeleportService")
	local request = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request

	local Configuration = {
		["Rejoin_Time"] = 60,
	}

	local Webhook_List = {
		["Testing_Hook"] = "https://discord.com/api/webhooks/1367817042341658737/w5gnVpkfS1qawZQl61biumR-KQsevuBplgcT5hcCrffJ0bJKi-MmQ-eNf7s2nUkYazV6",
		["Debug_Hook"] = "https://discord.com/api/webhooks/1367595896233132064/kjpvO_XjHBPNZ9r84b3kxyO6m4nZgmbDwxTBx1u3FYKTGrUsQ5Zvika5ghs3l7QPfg4F",
		["Errors_Hook"] = "https://discord.com/api/webhooks/1367817718258204722/F6TeAIurssFprg_J79Bqg93TFrR2sPyH4yvPjcACJmfOmmecwIYpx7IDIIpKE8hDs_kz",
	}

	local AllowedRifts = {
		["void-egg"] = {
			EmbedColor = 10181046, 
			Name = "Void Egg", 
			RolePing = "1367603349481984238",
			FreeHook = "https://discord.com/api/webhooks/1367585532191834292/dPv_qBisQ83OhQ34OM5csEOUOpA8dK0e_2-eOmJkY4p0YJtnajnMbWAtbmeV7N3rIQ6Q",
			PaidHook = "https://discord.com/api/webhooks/1367816775701499944/5EQ45xojpk4lvoqJbFkQSQJGQRi0Sed-sznfnUWseRN4lSB_FpyuQato28purLJ8Gf2m",
		},

		["nightmare-egg"] = {
			EmbedColor = 10038562, 
			Name = "Nightmare Egg", 
			RolePing = "1367603302476288020",
			FreeHook = "https://discord.com/api/webhooks/1367815943597850655/HBRpu6swD1kUoNf74mHVNlQK3UBmKYQb79aaZ6QwGHcjEBr7UnvF77pQaLgdL3BC8cjx",
			PaidHook = "https://discord.com/api/webhooks/1367816768780894289/gI7HOAT7d_9HnSJk6NPzsyHqm1HztB935fDptM5WpJLgjnq6PsWvHlqfv1hIM_k5OWmd",
		},

		["rainbow-egg"] = {
			EmbedColor = 15277667, 
			Name = "Rainbow Egg", 
			RolePing = "1367603395845685328",
			FreeHook = "https://discord.com/api/webhooks/1367815862819622942/D1VYO5b6RouHHYXiVjtSu4GlEFno3RiPlfOkPr4HI-u1uycPGdR-Yc7OTjpI5FG1fdDW",
			PaidHook = "https://discord.com/api/webhooks/1367815942528303214/mM76nBIn67w3_qMujYujJ9V8ckbqNSmSJfDMvzIl_XQSU0V9gkBU_2OGvwokydmKd9yy",
		},

		["silly-egg"] = {
			EmbedColor = 15844367,
			Name = "Silly Egg", 
			RolePing = "1367603190387834901",
			FreeHook = "https://discord.com/api/webhooks/1367815363429007411/hOTpPclZ58MDrutrJMxwppHg_n4HZKg0by5vYeUrt8ZgQu3N-KsZsG9SVZZjr0h6dTf-",
			PaidHook = "https://discord.com/api/webhooks/1367816419059826688/_wcnFCr-VBdWbOg-xowvhwADI9Lf0Lfb925oRrSPWOjKNb4TnvJUsP5SP6tWRQ7gWlYW",
		},
	}

	local PlaceID = game.PlaceId
	local Player = game.Players.LocalPlayer
	local Timestamp = os.time()
	local Server_Link = "roblox://placeId=" .. tostring(PlaceID) .. "&gameInstanceId=" .. tostring(game.JobId)

	----------------------------------------[ Discord Integration ]----------------------------------------

	local function SendMessage(url, message)
		local http = game:GetService("HttpService")
		local headers = {
			["Content-Type"] = "application/json"
		}
		local data = {
			["content"] = message
		}
		local body = http:JSONEncode(data)
		local response = request({
			Url = url,
			Method = "POST",
			Headers = headers,
			Body = body
		})
	end

	local function SendEmbed(url, message, embed)
		local http = game:GetService("HttpService")
		local headers = {
			["Content-Type"] = "application/json"
		}
		local data = {
			["content"] = message,
			["embeds"] = {
				{
					["title"] = embed.title,
					["description"] = embed.description,
					["color"] = embed.color,
					["fields"] = embed.fields,
					["footer"] = {
						["text"] = embed.footer.text
					}
				}
			}
		}
		local body = http:JSONEncode(data)
		local response = request({
			Url = url,
			Method = "POST",
			Headers = headers,
			Body = body
		})
	end

	----------------------------------------[ Embeds ]----------------------------------------

	local function CreateEmbed(RiftName, TimeLeft, Multiplier, Height, EmbedColor)
		local NewEmbed = {
			["title"] = "New Rift Found!",
			["description"] = "*<t:" .. Timestamp .. ":R>*",
			["fields"] = {
				{
					["name"] = "🥚 Rift Name",
					["value"] = "```" .. RiftName .. "```",
				},
				{
					["name"] = "⌚ Time Left",
					["value"] = "```" .. TimeLeft .. "```",
				},
				{
					["name"] = "🍀 Luck Multiplier",
					["value"] = "```" .. Multiplier .. "```",
				},
				{
					["name"] = "🎈 Height",
					["value"] = "```" .. Height .. "```",
				},
				{
					["name"] = "🔑 Server Link",
					["value"] = "```" .. Server_Link .. "```",
				},
				{
					["name"] = "👥 Server Space",
					["value"] = "```" .. tostring(#game.Players:GetChildren()) .. "/" .. tostring(game.Players.MaxPlayers) .. " Players```",
				},

			},
			["color"] = EmbedColor,
			["footer"] = {
				["text"] = ""
			},
		}

		return NewEmbed
	end
	
	----------------------------------------[ Server Hop ]----------------------------------------

	local function ServerHop()
		local servers = {}
		local req = request({
			Url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true", game.PlaceId)
		})
		local body = game:GetService("HttpService"):JSONDecode(req.Body)

		if body and body.data then
			for _, v in ipairs(body.data) do
				if type(v) == "table" and tonumber(v.playing) and tonumber(v.maxPlayers) and v.playing < v.maxPlayers and v.playing >= 2 and v.id ~= game.JobId then
					table.insert(servers, v.id)
				end
			end
		end

		if #servers > 0 then
			game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], game.Players.LocalPlayer)
		else
			SendMessage(Webhook_List["Errors_Hook"], "Error for: `" .. tostring(Player.Name) .. "` `No server found - Retrying in " .. tostring(Configuration["Rejoin_Time"]) .. "s`")

			task.wait(Configuration["Rejoin_Time"])

			ServerHop()
		end
	end
	
	TeleportService.TeleportInitFailed:Connect(function(plr, id, status, _error)
		SendMessage(Webhook_List["Errors_Hook"], "Error for: `" .. tostring(Player.Name) .. "` `Teleport failed - Retrying in " .. tostring(Configuration["Rejoin_Time"]) .. "s` `" .. tostring(_error) .. "` `" .. tostring(status) .. "`")


		task.wait(Configuration["Rejoin_Time"])

		ServerHop()
	end)

	----------------------------------------[ Main Finder ]----------------------------------------

	SendMessage(Webhook_List["Debug_Hook"], "Account launched: `" .. tostring(Player.Name) .. "` `Premium: " .. tostring(IsVIP) .. "` `ID: " .. tostring(game.JobId) .. "` `" .. tostring(Ver) .. "`")

	local function Search(IsVIP)
		warn("Searching, premium status:", IsVIP)
		for _, Rift in workspace.Rendered.Rifts:GetChildren() do
			task.wait(0.05)

			local RiftName = Rift.Name

			if AllowedRifts[RiftName] then
				if Rift.Display.SurfaceGui.Icon.Luck.Text == "x25" then 
					local RiftLuck = Rift.Display.SurfaceGui.Icon.Luck
					local RiftTime = Rift.Display.SurfaceGui.Timer
					local RiftHeight = math.floor(Rift.Display.CFrame.Y)
					local RiftStringName = AllowedRifts[RiftName].Name
					local WebhookToSend = nil


					warn("Found Rift!")
					SendMessage(Webhook_List["Debug_Hook"], "Rift Found: `" .. tostring(RiftStringName) .. "` `" .. tostring(RiftLuck.Text) .. "` `" .. tostring(RiftTime.Text) .. "` `" .. tostring(RiftHeight ) .. "`")

					SendEmbed(tostring(AllowedRifts[RiftName].PaidHook), "<@&" .. tostring(AllowedRifts[RiftName].RolePing) .. ">", CreateEmbed(tostring(RiftStringName), tostring(RiftTime.Text), tostring(RiftLuck.Text), tostring(RiftHeight), AllowedRifts[RiftName].EmbedColor))
					
					if IsVIP == false then
						SendEmbed(tostring(AllowedRifts[RiftName].FreeHook), "<@&" .. tostring(AllowedRifts[RiftName].RolePing) .. ">", CreateEmbed(tostring(RiftStringName), tostring(RiftTime.Text), tostring(RiftLuck.Text), tostring(RiftHeight), AllowedRifts[RiftName].EmbedColor))
					end
					
					--[[
					warn(tostring(WebhookToSend))
					warn(tostring("<@&" .. tostring(AllowedRifts[RiftName].RolePing) .. ">"))
					warn(tostring(RiftStringName))
					warn(tostring(RiftTime))
					warn(tostring(RiftTime))
					warn(tostring(RiftHeight))
					warn(AllowedRifts[RiftName].EmbedColor)
					]]
				end
			end
		end
	end
	
	Search(IsVIP)
	
	warn("Changing servers in:", Configuration["Rejoin_Time"] .. "s")
	
	task.wait(Configuration["Rejoin_Time"])
	
	ServerHop()
end


return RiftFinder
